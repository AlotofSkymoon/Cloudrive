{
  "name": "cloudrive",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "基于 Cloudflare Workers + R2/任意 S3 存储的自建网盘分享系统（直链下载）",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build && node scripts/embed-assets.mjs",
    "build:web": "vite build",
    "embed": "node scripts/embed-assets.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup-resources.mjs",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:init": "wrangler d1 execute filecove --file=./schema.sql --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "vue": "^3.5.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}
