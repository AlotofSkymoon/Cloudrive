{
  "name": "filecove",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "基于 Cloudflare Workers + R2/任意 S3 存储的自建网盘分享系统（直链下载）",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node -e \"console.log('Filecove 无需构建步骤')\"",
    "setup": "node scripts/setup-resources.mjs",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:init": "wrangler d1 execute filecove --file=./schema.sql --remote",
    "test": "node --test test/"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
